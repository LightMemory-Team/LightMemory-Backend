# --- Django 安全設定 ---
# 開發請設 True；正式環境不要設或設 False（預設就是 False）
DJANGO_DEBUG=True
# DEBUG 關閉時一定要設，沒設服務會起不來。產生方式：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 不可以用 django-insecure- 開頭的金鑰
# DJANGO_SECRET_KEY=
# 以逗號分隔；不設就用預設（localhost、127.0.0.1、.trycloudflare.com）
# DJANGO_ALLOWED_HOSTS=api.example.com,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# CORS：開發（DEBUG 開啟）預設允許所有來源；正式環境要明確列出 Flutter Web 的網址
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

DB_NAME=你的資料庫名稱
DB_USER=你的帳號名稱
DB_PASSWORD=你的密碼
DB_HOST=localhost
DB_PORT=5432

FIREBASE_PROJECT_ID=你的Firebase專案ID
FIREBASE_CREDENTIALS_PATH=secrets/firebase-key.json
FIREBASE_STORAGE_BUCKET=lightmemory-sqlf.firebasestorage.app

OPENAI_API_KEY=你的OpenAI金鑰
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1